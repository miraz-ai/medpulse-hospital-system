# ==============================================================================
# MedPulse Enterprise Hospital Management System
# Production Apache Security & Directory Hardening Policy
# ==============================================================================

# 1. Disable Directory Indexing / Directory Browsing
Options -Indexes

# 2. Block direct web access to sensitive hidden files & directories (.env, .git, etc.)
<FilesMatch "^\.(env|git|gitignore|htaccess|idea|vscode)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct web access to sensitive file extensions (SQL dumps, logs, package descriptors)
<FilesMatch "\.(sql|log|dump|bak|md|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Disable TRACE and TRACK HTTP methods
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [F]
</IfModule>
