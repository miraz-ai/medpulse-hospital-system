# ==============================================================================
# MedPulse HMS — Database Directory Security Guard
# Strictly block all direct HTTP/HTTPS web access to SQL schemas and seeds
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
