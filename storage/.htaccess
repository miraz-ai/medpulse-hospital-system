# ==============================================================================
# MedPulse HMS — Storage Directory Security Guard
# Strictly block all direct HTTP/HTTPS web access to logs, events, and dumps
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
