# ==============================================================================
# MedPulse Enterprise Hospital Management System (HMS)
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local/production environment
# ==============================================================================

# Database Connection Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medpulse_hms
DB_USER=root
DB_PASS=

# Application Runtime Environment (local, staging, production)
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/MedPulse

# Enterprise Session & Security Guards
SESSION_LIFETIME=3600
SESSION_SECURE_COOKIE=false
CSRF_SECRET=change_this_to_a_random_32_character_secret_string

# WebSocket Real-Time Event Gateway
WS_HOST=127.0.0.1
WS_PORT=8080
