# ==============================================================================
# MedPulse HMS — Config Directory Security Guard
# Strictly block all direct HTTP/HTTPS web access to database credentials & configs
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
